LAWHOT_PUBLIC_BASE_URL=https://hot.fachuiai.com
LAWHOT_FETCH_INTERVAL_SECONDS=1800
# 国内构建用基础镜像（勿写 docker.io/library/... 直连）
LAWHOT_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# 可选：触发手动抓取 POST /admin/ingest
LAWHOT_ADMIN_TOKEN=change-me

# 方案 A：境外信源走洛杉矶 HTTP 代理（国内源直连）
# 在洛杉矶机查看：cat /etc/lawhot/proxy.env
# 示例（勿把真实密码提交到 git）：
# LAWHOT_HTTP_PROXY=http://lawhot:YOUR_PASS@192.3.90.184:13128
# LAWHOT_HTTPS_PROXY=http://lawhot:YOUR_PASS@192.3.90.184:13128
LAWHOT_HTTP_PROXY=
LAWHOT_HTTPS_PROXY=
LAWHOT_NO_PROXY=localhost,127.0.0.1,.cn,cac.gov.cn,court.gov.cn,gov.cn,miit.gov.cn,npc.gov.cn,moj.gov.cn,legaldaily.com.cn

# 英文译中（强烈建议配置；走洛杉矶代理访问境外 API，或改成国内兼容接口）
# 例：DeepSeek OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
